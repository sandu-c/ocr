{
  "name": "@sanduc/ocr",
  "version": "1.4.8",
  "workspaces": [
    "packages/browser",
    "packages/browser/example",
    "packages/common",
    "packages/models",
    "packages/node",
    "packages/node/example",
    "packages/react-native",
    "packages/react-native/example"
  ],
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@types/bun": "latest",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "release:patch": "./release.sh $(node -p \"require('./packages/common/package.json').version.replace(/(\\d+)$/, (m) => +m + 1)\")",
    "release:minor": "./release.sh $(node -p \"const v=require('./packages/common/package.json').version.split('.'); v[1]=+v[1]+1; v[2]=0; v.join('.')\")",
    "release:major": "./release.sh $(node -p \"const v=require('./packages/common/package.json').version.split('.'); v[0]=+v[0]+1; v[1]=0; v[2]=0; v.join('.')\")"
  }
}
