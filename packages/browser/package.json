{
  "name": "@sanduc/ocr-browser",
  "version": "1.4.11",
  "description": "OCR Javascript library for Node.js, Browser, React Native and C++. Based on PaddleOCR and ONNX Runtime. Fork of Guten OCR.",
  "keywords": [
    "ocr",
    "paddleocr",
    "typescript",
    "onnxruntime",
    "web",
    "browser"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandu-c/ocr.git",
    "directory": "packages/browser"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "node": "./build/index.js",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./vite": {
      "types": "./build/vite-plugin.d.ts",
      "default": "./build/vite-plugin.js"
    }
  },
  "files": [
    "src",
    "build",
    "!**/__tests__"
  ],
  "scripts": {
    "prepublishOnly": "cp ../../README.md . && rm -rf build && bun run tsc --project tsconfig.build.json --skipLibCheck && bun run tsc-alias --project tsconfig.build.json",
    "postpublish": "rm README.md && rm -rf build"
  },
  "dependencies": {
    "@sanduc/ocr-common": "^1.4.11",
    "@sanduc/ocr-models": "^1.4.11",
    "onnxruntime-web": "^1.17.3"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^1.0.0"
  },
  "peerDependencies": {
    "vite-plugin-static-copy": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "vite-plugin-static-copy": {
      "optional": true
    }
  }
}
