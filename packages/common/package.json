{
  "name": "@sanduc/ocr-common",
  "description": "OCR Javascript library for Node.js, Browser, React Native and C++. Based on PaddleOCR and ONNX Runtime. Fork of Guten OCR.",
  "version": "1.5.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandu-c/ocr.git",
    "directory": "packages/common"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./splitIntoLineImages": {
      "bun": "./src/backend/splitIntoLineImages.ts",
      "react-native": "./src/backend/splitIntoLineImages.ts",
      "default": "./build/backend/splitIntoLineImages.js"
    }
  },
  "files": [
    "src",
    "build",
    "tsconfig.json",
    "!**/__tests__"
  ],
  "scripts": {
    "prepublishOnly": "cp ../../README.md . && rm -rf build && bun run tsc --project tsconfig.build.json && bun run tsc-alias --project tsconfig.build.json",
    "postpublish": "rm README.md && rm -rf build"
  },
  "dependencies": {
    "tiny-invariant": "^1.3.3",
    "@techstark/opencv-js": "^4.9.0-release.3",
    "js-clipper": "^1.0.1"
  }
}
